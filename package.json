{
  "name": "react-maskify",
  "version": "0.3.0",
  "description": "Input mask component and hook for React 17-19. Maintained replacement for react-input-mask with a compat entry, Korean presets and a migration codemod. Zero dependencies, TypeScript.",
  "author": "rjsgud49",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./compat": {
      "import": {
        "types": "./dist/compat.d.ts",
        "default": "./dist/compat.js"
      },
      "require": {
        "types": "./dist/compat.d.cts",
        "default": "./dist/compat.cjs"
      }
    },
    "./presets": {
      "import": {
        "types": "./dist/presets.d.ts",
        "default": "./dist/presets.js"
      },
      "require": {
        "types": "./dist/presets.d.cts",
        "default": "./dist/presets.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "keywords": [
    "react",
    "input",
    "mask",
    "input-mask",
    "masked-input",
    "react-input-mask",
    "react-input-mask-alternative",
    "react-text-mask",
    "react-19",
    "findDOMNode",
    "hook",
    "useMask",
    "phone",
    "credit-card",
    "date",
    "format",
    "typescript",
    "korean",
    "react-hook-form",
    "react19",
    "react-18",
    "korean-phone",
    "business-registration-number",
    "resident-registration-number",
    "codemod",
    "ssr"
  ],
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:react18": "npm i --no-save react@18 react-dom@18 && vitest run; s=$?; npm i --no-save react@19 react-dom@19; exit $s",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "size": "node scripts/size.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run test:react18 && npm run build",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rjsgud49/react-maskify.git"
  },
  "homepage": "https://github.com/rjsgud49/react-maskify#readme",
  "bugs": {
    "url": "https://github.com/rjsgud49/react-maskify/issues"
  },
  "typesVersions": {
    "*": {
      "compat": [
        "./dist/compat.d.ts"
      ],
      "presets": [
        "./dist/presets.d.ts"
      ]
    }
  },
  "bin": {
    "react-maskify": "./bin/cli.mjs"
  }
}
